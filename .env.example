SETUORA_APP_MODE=master
APP_NAME=Setuora Master
APP_SECRET_KEY=change-this-before-production
DATABASE_URL=sqlite:///./data/setuora.db
SESSION_TIMEOUT_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start

# The Windows-native admin console is intentionally local-only HTTP.
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=127.0.0.1,localhost
SETUORA_WEB_PORT=8000

# Windows OpenSSH and Setuora share this exchange root. Setup replaces this
# relative development value with C:/ProgramData/Setuora/sftp.
SFTP_SYNC_ENABLED=true
SFTP_EXCHANGE_ROOT=./data/sftp
SFTP_SYNC_INTERVAL_SECONDS=5
SFTP_FILE_SETTLE_SECONDS=2
SFTP_MAX_XML_BYTES=10485760

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

AUTOMATIC_BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./data/backups
BACKUP_OFFSITE_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_STARTUP_DELAY_SECONDS=60

NODE_API_RATE_LIMIT_PER_MINUTE=120
NODE_API_MAX_EVENT_ITEMS=5000
NODE_API_MAX_BODY_BYTES=5242880
FRANCHISE_OFFLINE_MINUTES=15
