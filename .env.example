SETUORA_APP_MODE=master
APP_NAME=Setuora Master
APP_SECRET_KEY=change-this-before-production
# The Compose deployment overrides this with its persistent named volume.
DATABASE_URL=sqlite:///./data/setuora.db
SESSION_TIMEOUT_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
# Tailscale Serve terminates HTTPS. Keep secure cookies enabled remotely.
SESSION_COOKIE_SECURE=true
# Setup replaces this bootstrap wildcard with the exact MagicDNS name.
TRUSTED_HOSTS=*.ts.net,127.0.0.1,localhost

# Universal Docker/Tailscale deployment. Generate a one-off, non-ephemeral,
# pre-authorized auth key tagged tag:setuora-master. Setup removes it after
# successful enrollment. Keep this file out of source control.
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=setuora-master
TAILSCALE_TAG=tag:setuora-master
# Local health/troubleshooting port; Docker binds it only to loopback.
SETUORA_LOCAL_PORT=8000

# Failed-login throttle (per username).
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Verified automatic SQLite backups.
AUTOMATIC_BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./data/backups
# Optional: use another drive or network share for an off-machine copy.
BACKUP_OFFSITE_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_STARTUP_DELAY_SECONDS=60

# Authenticated Setuora-Lite node API limits. Keep the reverse proxy's body and
# rate limits aligned with these application limits.
NODE_API_RATE_LIMIT_PER_MINUTE=120
NODE_API_MAX_EVENT_ITEMS=5000
NODE_API_MAX_BODY_BYTES=5242880
FRANCHISE_OFFLINE_MINUTES=15
